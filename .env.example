# SERVER ONLY: configure in Netlify's Functions environment, not public frontend variables.
# npm start stays in no-delivery preview mode regardless of these settings.
ENABLE_LIVE_INTAKE=false
PUBLIC_SITE_URL=
# Public Twilio voice line (E.164), not your personal WhatsApp number.
PUBLIC_VOICE_NUMBER=
# Public Postmark inbound address or your inbound email alias.
PUBLIC_INBOUND_EMAIL=
POSTMARK_WEBHOOK_USER=
# At least 24 random URL-safe characters.
POSTMARK_WEBHOOK_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 numbers without a whatsapp: prefix. Neither value is sent to the browser.
TWILIO_WHATSAPP_FROM=
OWNER_WHATSAPP_TO=
# Approved WhatsApp Content template: {{1}} channel, {{2}} reply detail, {{3}} brief.
TWILIO_CONTENT_SID=
# For a joined sandbox / open 24-hour service window ONLY. Default requires a template.
ALLOW_SESSION_MESSAGES=false
# Optional. Without a model key, the handoff contains a bounded original excerpt.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
