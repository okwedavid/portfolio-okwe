{
  "name": "okwe-david-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Okwe David's engineering portfolio and private contact desk.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "parcel build index.html engineering-brief.html --dist-dir dist --no-source-maps",
    "prestart": "npm run build",
    "start": "node server/preview.mjs",
    "watch": "parcel watch index.html engineering-brief.html --dist-dir dist --no-hmr",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "preview:offline": "node scripts/export-preview.mjs"
  },
  "author": "Okwe David",
  "license": "ISC",
  "dependencies": {
    "@netlify/blobs": "^11.1.9",
    "html-to-text": "^10.0.1"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "@playwright/test": "^1.65.1",
    "parcel": "^2.16.4",
    "sass": "^1.93.0"
  }
}
